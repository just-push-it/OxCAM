{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oxcam.invalid/schemas/workholding.v2.schema.json",
  "title": "OxCAM workholding template (workholding.json inside a .ocamhold archive), version 2",
  "description": "A fixture made of STEP parts (stored beside this document as bodies/<sha256>.step, or among a project's models) in shared template coordinates, in millimetres. Each part is carried by the fixed base or by a member that moves along a line within its travel range (linked members follow another member's travel times their ratio, along their own direction). Datums are named points with a direction: picked on a part's face, edge or vertex (moving with the part's member; 'point' and 'direction' are its geometry as modelled), typed (moving with 'member'), offset from another datum along template X, Y, Z or that datum's direction, or the midpoint of two. Holdings say where the stock sits: between two jaw faces (its side on face_a, its bottom grip_depth below the 'seat' datum), on a dovetail (flanks face_a and face_b, its shoulder on the seat, its tenon depth below it), or at a seat frame (origin and Z from 'seat', X from 'x_datum'; the stock box point 'anchor' there, per axis 0 = min, 1 = middle, 2 = max). 'mount' is the datum the workholding sits on the machine by. Version 1 documents (bodies with jaw roles, one datum frame, an opening range) are migrated when read. See docs/design-log/0035-workholding-templates.md.",
  "type": "object",
  "required": ["format", "version", "id", "name", "parts", "holdings"],
  "properties": {
    "format": { "const": "oxcam.workholding" },
    "version": { "const": 2 },
    "units": { "const": "mm" },
    "id": { "$ref": "#/definitions/uuid" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sha256"],
        "properties": {
          "id": { "$ref": "#/definitions/uuid" },
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_path": { "type": "string" },
          "member": { "type": "string" },
          "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "collides": { "type": "boolean" },
          "shown": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "direction", "min_travel", "max_travel"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "direction": { "$ref": "#/definitions/vec3" },
          "min_travel": { "type": "number" },
          "max_travel": { "type": "number" },
          "linked_to": { "type": "string" },
          "ratio": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "datums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["picked", "typed", "offset", "midpoint"] },
          "shape": { "enum": ["plane", "axis", "line", "point"] },
          "part": { "type": "string" },
          "type": { "enum": ["face", "edge", "vertex"] },
          "index": { "type": "integer", "minimum": 0 },
          "signature": {
            "type": "object",
            "required": ["centroid", "direction", "measure"],
            "properties": {
              "centroid": { "$ref": "#/definitions/vec3" },
              "direction": { "$ref": "#/definitions/vec3" },
              "measure": { "type": "number" }
            },
            "additionalProperties": false
          },
          "member": { "type": "string" },
          "point": { "$ref": "#/definitions/vec3" },
          "direction": { "$ref": "#/definitions/vec3" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "along": { "enum": ["x", "y", "z", "direction"] },
          "distance": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "holdings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["jaws", "dovetail", "seat"] },
          "face_a": { "type": "string" },
          "face_b": { "type": "string" },
          "seat": { "type": "string" },
          "x_datum": { "type": "string" },
          "grip_depth": { "type": "number", "minimum": 0 },
          "depth": { "type": "number", "minimum": 0 },
          "tenon_width": { "type": "number", "minimum": 0 },
          "anchor": {
            "type": "array",
            "items": { "enum": [0, 1, 2] },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "additionalProperties": false
      }
    },
    "mount": { "type": "string" },
    "up": { "$ref": "#/definitions/vec3" }
  },
  "additionalProperties": false,
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
